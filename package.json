{
  "name": "fifo-fiscal",
  "version": "0.1.0",
  "private": true,
  "description": "Cálculo FIFO y declaración IRPF (AEAT) para bolsa y criptomonedas: DEGIRO, Trade Republic, Kraken, Revolut y Coinbase.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.ts --dev",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
